<view class="lpage dpage" style="padding-bottom: {{bottomPad}}px">

  <!-- 彩种切换 -->
  <view class="ltabs">
    <view
      class="ltab {{item.active ? 'ltab--active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onSwitchTab"
    >{{item.name}}</view>
  </view>

  <view class="lstate" wx:if="{{loading && !list.length}}">正在加载开奖数据…</view>
  <view class="lstate lstate--error" wx:if="{{error}}">{{error}}</view>
  <view class="lstate" wx:if="{{!loading && !list.length && !error}}">暂无开奖数据</view>

  <!-- 开奖记录 -->
  <view class="dcard" wx:for="{{list}}" wx:for-item="d" wx:key="period">
    <view class="dhead">
      <text class="dperiod">第 {{d.period}} 期</text>
      <text class="ddate">{{d.date}} 开奖</text>
    </view>

    <view class="dballs">
      <text class="dball" wx:for="{{d.main}}" wx:for-item="b" wx:key="n">{{b.text}}</text>
      <text class="dball dball--extra" wx:for="{{d.extra}}" wx:for-item="b" wx:key="n">{{b.text}}</text>
    </view>

    <view class="dfoot">
      <text class="dmeta">全国销量 {{d.sales}}</text>
      <text class="dmeta">奖池 {{d.pool}}</text>
    </view>
  </view>

  <!-- 分页 -->
  <view class="dmore" wx:if="{{hasMore}}" bindtap="onLoadMore">
    {{loadingMore ? '加载中…' : '加载更多（共 ' + total + ' 期）'}}
  </view>
  <view class="dmore dmore--end" wx:elif="{{list.length}}">已经到底了 · 共 {{total}} 期</view>

</view>
