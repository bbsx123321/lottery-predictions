<view class="lpage" style="padding-bottom: {{bottomPad}}px">

  <!-- 副标题行 -->
  <view class="lsub">
    <text class="lsub-text">官方开奖数据 · 每期自动更新</text>
    <view class="lsub-btn" bindtap="onDebug">
      <text class="lsub-btn-text">环境自检</text>
    </view>
  </view>

  <!-- 彩种切换 -->
  <view class="ltabs">
    <view
      class="ltab {{item.active ? 'ltab--active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onSwitchTab"
    >{{item.name}}</view>
  </view>

  <!-- 加载中 / 出错 -->
  <view class="lstate" wx:if="{{loading && !latest}}">正在加载开奖数据…</view>
  <view class="lstate lstate--error" wx:if="{{error}}">{{error}}</view>

  <!-- 最新一期中奖号码 -->
  <view class="lcard" wx:if="{{latest}}">
    <view class="lcap">
      <text class="lcap-left">第 {{latest.period}} 期</text>
      <text class="lcap-right">{{latest.date}} 开奖</text>
    </view>

    <view class="lballs">
      <text class="lball" wx:for="{{latest.main}}" wx:key="n">{{item.text}}</text>
      <text class="lball lball--extra" wx:for="{{latest.extra}}" wx:key="n">{{item.text}}</text>
    </view>

    <view class="ldivider"></view>

    <view class="lstats">
      <view class="lstat">
        <text class="lstat-value lstat-value--accent">{{latest.pool}}</text>
        <text class="lstat-label">奖池奖金</text>
      </view>
      <view class="lstat">
        <text class="lstat-value">{{latest.sum}}</text>
        <text class="lstat-label">本期和值</text>
      </view>
      <view class="lstat">
        <text class="lstat-value">{{latest.span}}</text>
        <text class="lstat-label">本期跨度</text>
      </view>
      <view class="lstat">
        <text class="lstat-value">{{latest.sales}}</text>
        <text class="lstat-label">全国销量</text>
      </view>
    </view>
  </view>

  <!-- 工具箱 -->
  <view class="lcard">
    <view class="lcard-head">
      <text class="lcard-title">工具箱</text>
      <text class="lcard-meta">8 个工具</text>
    </view>

    <view class="tool-grid">
      <view
        class="tool-item"
        wx:for="{{tools}}"
        wx:key="key"
        data-url="{{item.url}}"
        bindtap="onToolTap"
      >
        <view class="tool-icon tool-icon--{{item.tint}}"></view>
        <text class="tool-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 近期 10 期 -->
  <view class="lcard">
    <view class="lcard-head">
      <text class="lcard-title">近期开奖</text>
      <text class="lcard-link" bindtap="onMoreHistory">查看全部 ›</text>
    </view>

    <view class="lthead">
      <text class="lth-col lth-period">期号</text>
      <text class="lth-col lth-date">开奖日期</text>
      <text class="lth-col lth-nums">{{mainLabel}}</text>
      <text class="lth-col lth-extra" wx:if="{{hasExtra}}">{{extraLabel}}</text>
      <text class="lth-col lth-pool">奖池</text>
    </view>

    <view class="ltrow {{index % 2 === 0 ? 'ltrow--tint' : ''}}" wx:for="{{recent}}" wx:key="period">
      <text class="lth-col lth-period ltperiod">{{item.period}}</text>
      <text class="lth-col lth-date ltdate">{{item.shortDate}}</text>
      <text class="lth-col lth-nums ltnums">{{item.mainText}}</text>
      <text class="lth-col lth-extra ltextra" wx:if="{{hasExtra}}">{{item.extraText}}</text>
      <text class="lth-col lth-pool ltpool">{{item.pool}}</text>
    </view>
  </view>

</view>
