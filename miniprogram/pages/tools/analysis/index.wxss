/* 数据分析页 —— 吉号分析 / 智能规律 / 选号分布 */

/* ---------- 热号冷号 ---------- */

.ahot {
  padding: 20rpx 0;
  border-top: 2rpx solid var(--line);
}

.ahot:first-of-type {
  padding-top: 4rpx;
  border-top: none;
}

.ahot-label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.ahot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

/* 热号/冷号药丸：号码 + 出现次数 */
.apill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  border-radius: var(--radius-pill);
  background: var(--accent-soft);
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent);
}

.apill--cold {
  background: var(--row-tint);
  color: var(--text-secondary);
}

.apill-count {
  font-size: 19rpx;
  font-weight: 400;
  opacity: 0.7;
}

.ahot--miss {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.ahot-miss-text {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ---------- 频次表 ---------- */

.afreq-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-top: 2rpx solid var(--line);
}

.afreq-row--head {
  border-top: none;
  padding-bottom: 8rpx;
}

.afreq-row--head .afreq-n,
.afreq-row--head .afreq-c,
.afreq-row--head .afreq-o {
  font-size: 20rpx;
  color: var(--text-muted);
}

.afreq-n {
  flex-shrink: 0;
  width: 72rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.afreq-n--hot {
  color: var(--accent);
}

.afreq-n--cold {
  color: var(--text-muted);
}

.afreq-c {
  flex-shrink: 0;
  width: 64rpx;
  font-size: 23rpx;
  color: var(--text-secondary);
}

.afreq-o {
  flex-shrink: 0;
  width: 64rpx;
  font-size: 23rpx;
  color: var(--text-secondary);
}

.afreq-b {
  flex: 1;
  min-width: 0;
  height: 14rpx;
  border-radius: 7rpx;
  background: var(--row-tint);
  overflow: hidden;
}

/* 表头那格是文字，不能带裁剪 */
.afreq-b--head {
  height: auto;
  background: none;
  overflow: visible;
  font-size: 20rpx;
  color: var(--text-muted);
}

.afreq-bar {
  height: 100%;
  border-radius: 7rpx;
  background: var(--accent);
}

/* ---------- 规律卡片 ---------- */

.apat {
  padding: 24rpx 0;
  border-top: 2rpx solid var(--line);
}

.apat:first-of-type {
  padding-top: 4rpx;
  border-top: none;
}

.apat-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.apat-label {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.apat-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.apat-value--hot {
  color: var(--accent);
}

.apat-value--cool {
  color: var(--blue);
}

.apat-detail {
  display: block;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

/* ---------- 区间分布 ---------- */

.abar-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 14rpx 0;
}

.abar-label {
  flex-shrink: 0;
  width: 120rpx;
  font-size: 23rpx;
  color: var(--text-secondary);
}

.abar-track {
  flex: 1;
  min-width: 0;
  height: 24rpx;
  border-radius: 12rpx;
  background: var(--row-tint);
  overflow: hidden;
}

.abar-fill {
  height: 100%;
  border-radius: 12rpx;
  background: var(--accent);
}

.abar-value {
  flex-shrink: 0;
  width: 64rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  text-align: right;
}

/* ---------- 尾数分布 ---------- */

.atail {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  height: 220rpx;
}

.atail-col {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.atail-track {
  width: 100%;
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: flex-end;
}

.atail-fill {
  width: 100%;
  min-height: 4rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: var(--accent);
}

.atail-count {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: var(--text-muted);
}

.atail-tail {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* ---------- 形态特征 ---------- */

.ashape {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-top: 2rpx solid var(--line);
}

.ashape:first-of-type {
  padding-top: 4rpx;
  border-top: none;
}

.ashape-main {
  flex: 1;
  min-width: 0;
}

.ashape-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-primary);
}

.ashape-detail {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--text-muted);
}

.ashape-value {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--accent);
}
