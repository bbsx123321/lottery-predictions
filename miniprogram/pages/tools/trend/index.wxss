/* 走势图选择页 —— 参考国内彩票 App 的走势图入口 */

.tmenu {
  padding-top: 24rpx;
}

/* ---------- 全国 / 地方 分段 ---------- */

.tseg-big {
  display: flex;
  justify-content: center;
  gap: 120rpx;
  padding: 24rpx 0 12rpx;
}

.tseg-big-item {
  position: relative;
  padding: 12rpx 8rpx 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.tseg-big-item--on {
  color: var(--accent);
}

.tseg-big-item--on::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 56rpx;
  height: 6rpx;
  margin-left: -28rpx;
  border-radius: 3rpx;
  background: var(--accent);
}

/* ---------- 彩种分组 ---------- */

.tlot {
  margin-top: 32rpx;
}

.tlot-title {
  padding: 0 32rpx 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* ---------- 算法按钮网格（3 列） ---------- */

.tgrid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 0 32rpx;
}

.tbtn {
  width: calc((100% - 40rpx) / 3);
  height: 88rpx;
  line-height: 88rpx;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 12rpx;
  background: #fdeeea;
  font-size: 25rpx;
  color: #a8342c;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tbtn:active {
  background: var(--accent-soft);
}

/* ---------- 地方空态 ---------- */

.tempty {
  padding: 120rpx 64rpx;
  text-align: center;
}

.tempty-icon {
  font-size: 72rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}

.tempty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.tempty-desc {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-muted);
}
