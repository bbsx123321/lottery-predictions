/* 走势图详情页 —— 表格形态，期次/星期固定，号码区横向滚动 */

.tdetail {
  min-height: 100vh;
  background: var(--bg);
}

/* ---------- 顶部说明 ---------- */

.thead-note {
  padding: 14px 16px 10px;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-muted);
  background: var(--surface);
}

/* ---------- 状态 ---------- */

.tstate {
  padding: 120rpx 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-muted);
}

.tstate--error {
  color: var(--danger);
}

/* ---------- 表格容器 ---------- */

.tscroll {
  width: 100%;
  background: var(--surface);
}

.ttable {
  position: relative;
  min-width: 100%;
  display: inline-block;
}

/* 行底色单独一层：画线夹在底色和数字中间 */
.tstripes {
  position: absolute;
  left: 0;
  top: 50px;
  z-index: 0;
  width: 100%;
}

.tstripe {
  height: 26px;
}

.tstripe--tint {
  background: var(--row-tint);
}

/* 画线层：每段线一个绝对定位的细条，绕起点旋转 */
.tlines {
  position: absolute;
  left: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.tline-seg {
  position: absolute;
  height: 1px;
  background: rgba(232, 72, 63, 0.5);
  transform-origin: 0 0;
}

.tline-seg--cold {
  background: rgba(47, 106, 224, 0.42);
}

/* ---------- 行 / 列 ---------- */

.trow {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  height: 26px;
  border-bottom: 1px solid var(--line);
}

.trow--head {
  position: sticky;
  top: 0;
  z-index: 3;
  background: var(--surface);
  border-bottom: 1px solid #e3e6ec;
}

.trow--group {
  border-bottom: none;
}

.tc {
  flex: 0 0 auto;
  height: 100%;
  line-height: 26px;
  text-align: center;
  font-size: 10px;
  border-right: 1px solid var(--line);
  overflow: hidden;
}

/* 固定列：横向滚动时不动 */
.tc--fix {
  position: sticky;
  z-index: 4;
  background: var(--surface);
  font-size: 12px;
  color: var(--text-secondary);
}

.tc--period {
  left: 0;
  width: 62px;
  font-weight: 600;
  color: var(--text-primary);
  border-right: 1px solid #e3e6ec;
}

.tc--week {
  left: 62px;
  width: 26px;
  border-right: 2px solid #dfe3ea;
}

.trow--head .tc--fix {
  z-index: 6;
}

.tsort {
  margin-left: 2px;
  font-size: 10px;
  color: var(--accent);
}

/* 表头第二行的列标题 */
.tc--col {
  font-size: 10px;
  color: var(--text-secondary);
  background: #fbfbfd;
}

.tc--col.tc--hot {
  color: var(--accent);
}

/* 表头里的热号列也要标红 —— 三个 class 才压得住下面的 .tc.matrix */
.tc.matrix.tc--col.tc--hot {
  color: var(--accent);
}

/* 分区标题（一区 / 二区 / 红球分析） */
.tgroup {
  flex: 0 0 auto;
  height: 26px;
  line-height: 26px;
  text-align: center;
  font-size: 11px;
  font-weight: 600;
  color: var(--text-primary);
  background: #f2f3f7;
  border-right: 1px solid #e3e6ec;
}

/* ---------- 号码单元格 ---------- */

/* 号码列：默认灰字（遗漏值） */
.tc.matrix {
  color: var(--text-muted);
  font-size: 10px;
}

/* 统计值单元格：深色字 */
.tc.value {
  font-size: 10px;
  color: var(--text-primary);
  font-weight: 500;
}

/*
 * 下面三条都写成 `.tc.matrix.xxx`（三个 class）。
 * 之前只写一个 class，压不住同为两个 class 的 `.tc.matrix` / `.tc.value` ——
 * 结果命中球里的号码是灰字（#9aa3ae）而不是白字。
 * 三个 class 优先级相同，靠源码顺序定胜负：热号 → 命中 → 连号/重号。
 */

/* 热号列标红 */
.tc.matrix.tc--warm {
  color: var(--accent);
}

/* 命中：红圈 + 白字 */
.tc.matrix.tc--hit {
  color: #ffffff;
  background: var(--accent);
  border-radius: 50%;
  width: 20px;
  /* 内联 width:24px（列宽）会盖掉上面的 width，用 max-width 卡回 20 */
  max-width: 20px;
  height: 20px;
  line-height: 20px;
  /* (24 - 20) / 2 —— 在 24px 列宽里居中，同时不破坏整行的列对齐 */
  margin: 0 2px;
  font-size: 10px;
  font-weight: 600;
}

/* 连号 / 重号：深色底 + 白字 */
.tc.matrix.tc--strong {
  color: #ffffff;
  background: var(--accent-deep);
}

/* ---------- 底部工具条 ---------- */

.tbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-top: 10px;
  background: var(--surface);
  border-top: 1px solid var(--line);
}

.tbar-item {
  flex: 1;
  text-align: center;
  font-size: 13px;
  color: var(--text-secondary);
}

.tbar-item--on {
  color: var(--accent);
  font-weight: 600;
}

.tbar-arrow {
  margin-left: 2px;
  font-size: 11px;
}

.tbar-sep {
  width: 1px;
  height: 16px;
  background: var(--line);
}

/* ---------- 底部弹层 ---------- */

.tpanel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  max-height: 70vh;
  overflow-y: auto;
  padding: 20px 16px 24px;
  background: var(--surface);
  border-radius: 20px 20px 0 0;
  box-shadow: 0 -4px 24px rgba(27, 29, 40, 0.12);
}

.tpanel-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.tpanel-opts {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tpanel-opt {
  flex: 0 0 auto;
  min-width: 140rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 36rpx;
  text-align: center;
  font-size: 25rpx;
  color: var(--text-secondary);
  background: var(--bg);
}

.tpanel-opt--on {
  background: var(--accent);
  color: #ffffff;
  font-weight: 600;
}

.tpanel-empty {
  padding: 24rpx 0 32rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

.tpanel-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.tpanel-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  border-radius: 32rpx;
  background: var(--accent-soft);
}

.tpanel-item-period {
  font-size: 21rpx;
  color: var(--text-muted);
}

.tpanel-item-num {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--accent-deep);
}

.tpanel-close {
  display: inline-block;
  min-width: 160rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0 12rpx 0 0;
  padding: 0 28rpx;
  border-radius: 36rpx;
  text-align: center;
  font-size: 25rpx;
  color: var(--text-secondary);
  background: var(--bg);
}

/* ---------- 精选优选 ---------- */

.tfav-block {
  margin-bottom: 24rpx;
}

.tfav-label {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 12rpx;
}

.tfav-nums {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tfav-num {
  display: inline-flex;
  align-items: baseline;
  gap: 4rpx;
  min-width: 72rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 16rpx;
  border-radius: 28rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent-deep);
  background: var(--accent-soft);
}

.tfav-num--blue {
  color: var(--blue);
  background: #eaf0fd;
}

.tfav-cnt {
  font-size: 18rpx;
  font-weight: 400;
  color: var(--text-muted);
}

.tfav-tip {
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-muted);
  margin-bottom: 20rpx;
}
