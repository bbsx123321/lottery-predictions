/* 选号页 */

.pgroup {
  padding: 24rpx 0;
  border-top: 2rpx solid var(--line);
}

.pgroup:first-child {
  padding-top: 8rpx;
  border-top: none;
}

.pgroup-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.pgroup-index {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.pgroup-shape {
  font-size: 21rpx;
  color: var(--text-muted);
}

.ltips {
  margin-top: 12rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: var(--row-tint);
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

/* 已存入「我的」的提示 */
.lsaved {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--accent-deep);
}

.lbtns {
  display: flex;
  gap: 20rpx;
}

.lbtns .lbtn {
  flex: 1;
}
